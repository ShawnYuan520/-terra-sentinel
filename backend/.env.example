# AgriSpatial AI 后端环境配置
# 复制此文件为 .env 并根据实际情况修改

# 应用
APP_NAME=AgriSpatial AI
APP_VERSION=0.1.0

# 数据库 (SQLite为默认，生产环境请切换到PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./agrispatial.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agrispatial

# JWT 密钥 (生产环境请用 openssl rand -hex 32 生成)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# 栅格数据目录 (GeoTIFF文件存放位置，不存在时自动降级到合成数据)
RASTER_DATA_DIR=./demo_data

# OpenWeather API Key (留空使用模拟数据)
OPENWEATHER_API_KEY=

# DeepSeek API Key (留空使用规则引擎降级)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Google Earth Engine (可选)
GEE_PROJECT=
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=
GEE_PROXY=

# CORS 允许的前端地址
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]
